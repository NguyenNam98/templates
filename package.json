{
  "name": "devbridge",
  "private": true,
  "packageManager": "pnpm@9.1.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-appconfig": "^3.624.0",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.6",
    "express": "^5.0.1",
    "form-data": "^4.0.0",
    "fstorm": "^0.1.3",
    "helmet": "^4.6.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qs": "^6.10.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.4",
    "uuid": "^9.0.1",
    "xss": "^1.0.11"
  },
  "devDependencies": {
    "@emotion/eslint-plugin": "^11.12.0",
    "@types/cookie-parser": "^1.4.2",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^17.0.21",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.3.2",
    "ts-loader": "^9.2.7",
    "ts-node": "^10.6.0",
    "tsconfig-paths": "^3.12.0",
    "turbo": "^2.0.0",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}